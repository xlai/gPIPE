linters: linters_with_defaults(
    line_length_linter(120),
    object_name_linter = NULL
  )
exclusions: sapply(
    c(list.files("tests/testthat", pattern = "[.]R$", full.names = TRUE),
      list.files("inst/simulations", pattern = "[.]R$", full.names = TRUE, recursive = TRUE)),
    function(f) list(object_usage_linter = Inf),
    simplify = FALSE
  )
encoding: "UTF-8"
